{
  "name": "world-freight-idle-product-mvp",
  "private": true,
  "type": "module",
  "scripts": {
    "test:frontend": "node --test frontend/*.test.mjs",
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "test:e2e": "playwright test",
    "lint:js": "eslint frontend",
    "lint:css": "stylelint frontend/style.css",
    "format:check": "prettier --check frontend *.config.js jsconfig.json .prettierrc.json",
    "format": "prettier --write frontend *.config.js jsconfig.json .prettierrc.json",
    "typecheck": "tsc --project jsconfig.json",
    "quality:frontend": "npm run lint:js && npm run lint:css && npm run format:check && npm run typecheck && npm run test:frontend && npm run build"
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "maplibre-gl": "6.10.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.1",
    "eslint": "10.10.0",
    "espree": "11.2.0",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "prettier": "3.9.8",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
