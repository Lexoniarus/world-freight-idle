# Copy to .env for local development. Real secrets remain outside Git.
HOST=0.0.0.0
PORT=8000
GAME_TIME_SCALE=1
COOKIE_SECURE=false
LOG_LEVEL=INFO
NOMINATIM_URL=https://nominatim.openstreetmap.org
VALHALLA_URL=https://valhalla1.openstreetmap.de
HTTP_USER_AGENT=WorldFreightIdle/0.2 (replace-with-your-contact)
VALHALLA_CLIENT_ID=world-freight-idle-local
# Maximum candidate distance from the original facility, at most 1000 metres.
ROUTING_ANCHOR_MAX_SNAP_M=1000

# Optional absolute path; otherwise the bundled data/world_freight_vehicle_catalog.sqlite3.
# VEHICLE_CATALOGUE_PATH=C:/catalogues/vehicles.sqlite3

# Separate read-only world references; independent of DB_PATH.
# WORLD_CATALOGUE_PATH=C:/catalogues/world_freight_company_facility_mvp.sqlite3
# NOMINATIM_URL serves offline enrichment and bounded backend anchor repair.

# Provider-owned Valhalla limits; raise only for your own service.
VALHALLA_CONCURRENCY=1
VALHALLA_MINIMUM_INTERVAL=1

# Production persistence. Use Supabase Direct Connection for IPv6-capable
# long-lived hosts, or the Session Pooler (port 5432) on IPv4-only hosts.
# Never commit the real password/URL.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER:5432/postgres
GAME_DATABASE_SCHEMA=game
WORLD_DATABASE_SCHEMA=world_catalogue
VEHICLE_DATABASE_SCHEMA=vehicle_catalogue
DATABASE_POOL_SIZE=5

# Supabase Auth. The publishable key and JWKS URL are safe client/public data.
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_SECRET_KEY is intentionally not consumed by this runtime.
