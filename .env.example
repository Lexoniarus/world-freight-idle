# Set these in the process environment; main.py does not load .env files.
HOST=0.0.0.0
PORT=8000
GAME_TIME_SCALE=1
COOKIE_SECURE=false
LOG_LEVEL=INFO
NOMINATIM_URL=https://nominatim.openstreetmap.org
VALHALLA_URL=https://valhalla1.openstreetmap.de
HTTP_USER_AGENT=WorldFreightIdle/0.2 (replace-with-your-contact)
VALHALLA_CLIENT_ID=world-freight-idle-local

# Optional absolute path; otherwise the bundled data/world_freight_vehicle_catalog.sqlite3.
# VEHICLE_CATALOGUE_PATH=C:/catalogues/vehicles.sqlite3
