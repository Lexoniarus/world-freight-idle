# Public frontend build settings. Copy to frontend/.env.local if needed.
# Never put private server credentials in VITE_* variables.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>
VITE_MAP_MAX_ZOOM=19
